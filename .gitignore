.env
state.json
__pycache__/
*.pyc
.venv/
data/
api/data/

# Локальные артефакты валидации/прогона (не коммитим)
.local-validation-data*/

# SQLite базы и бэкапы (prod jobs.db / валидация / тесты)
*.db
*.db-shm
*.db-wal
*.bak
jobs.db*

# Секреты/окружение (но .env.example остаётся в git)
.env.*
!.env.example
secrets/
credentials/

# Локальный файл владельца с реальными publication_code для ручного ввода метрик
# (Числа заполняются владельцем перед запуском --apply, в git не попадает)
metric_snapshots_video2.json

# Сгенерированный локальный growth-dashboard (python -m api.growth_dashboard)
dashboard/

# Эфемерные output'ы визуального конвейера кампаний (кандидаты кадров,
# baseplate-варианты, resolved-campaign-visual-lock.json и т.п.) — никогда
# не коммитятся, включая абсолютные локальные пути внутри resolved-снапшотов
content/autopilot/*/generated/

# B2B seller traffic factory: seller-uploaded product photos and all
# generated campaign output (dry-runs, delivery kits) never committed --
# only client.json/product.json/campaign.json metadata is tracked.
content/b2b/clients/*/products/*/references/
content/b2b/clients/*/products/*/campaigns/*/generated/
